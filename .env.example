# Get a real token from @BotFather. Never commit your .env file.
BOT_TOKEN=

# Positive Telegram user IDs, separated by commas.
# An empty list allows only /myid, so you can discover your ID first.
ALLOWED_USER_IDS=

# Relative paths are resolved from the project root.
# For Docker, override DB_PATH=/data/bot.db and mount a persistent folder at /data.
DB_PATH=data/bot.db
# Bot-specific timezone; takes priority over the container's TZ.
# TZ remains a fallback when BOT_TZ is absent or empty.
BOT_TZ=Asia/Bishkek
DEFAULT_LANG=ky

# Legacy setting accepted for compatibility; v1.1 always ignores outsiders silently.
ACCESS_DENIED_REPLY=false
